{
  "color": {
    "light": {
      "background": "#F2F3F5",
      "surface": "#FFFFFF",
      "surface-raised": "#FCFCFD",
      "text": "#151922",
      "text-muted": "#4E5665",
      "accent": "#1947C7",
      "accent-contrast": "#FFFFFF",
      "border": "#737B89",
      "success": "#0D6B3B",
      "danger": "#B42318",
      "focus-ring": "#1947C7"
    },
    "dark": {
      "background": "#10141C",
      "surface": "#1A202B",
      "surface-raised": "#232A37",
      "text": "#F4F6FA",
      "text-muted": "#B5BDCB",
      "accent": "#8CA9FF",
      "accent-contrast": "#111831",
      "border": "#707B8E",
      "success": "#6FD59C",
      "danger": "#FF8A84",
      "focus-ring": "#8CA9FF"
    }
  },
  "typography": {
    "display": {
      "family": "Chivo",
      "weight": 600,
      "file": "chivo-600.woff2",
      "fallback": "Arial, sans-serif"
    },
    "ui": {
      "family": "Public Sans",
      "weight": 400,
      "file": "public-sans-400.woff2",
      "fallback": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    },
    "scale": {
      "caption": {
        "fontSize": 12,
        "lineHeight": 16
      },
      "label": {
        "fontSize": 14,
        "lineHeight": 20
      },
      "body": {
        "fontSize": 16,
        "lineHeight": 24
      },
      "heading": {
        "fontSize": 20,
        "lineHeight": 28
      },
      "title": {
        "fontSize": 28,
        "lineHeight": 36
      },
      "display": {
        "fontSize": 40,
        "lineHeight": 48
      }
    }
  },
  "spacing": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48
  },
  "radii": {
    "sm": 6,
    "md": 10,
    "lg": 14,
    "pill": 999
  },
  "shadow": {
    "light": "0 8px 24px rgba(21, 25, 34, 0.12)",
    "dark": "0 8px 24px rgba(0, 0, 0, 0.36)"
  },
  "motion": {
    "fast": 120,
    "standard": 200,
    "deliberate": 320
  }
}
