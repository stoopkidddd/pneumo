# Fake local-development values only. Copy to .env.local; mise loads it automatically.
# Run mise run dev:infra for MinIO; its console is http://localhost:9001.
PORT=8080
PUBLIC_URL=http://localhost:8080
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pneumo
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_PREFIX=
UPLOAD_MODE=direct
PNEUMO_SETUP_TOKEN=dev-setup-token
LOG_LEVEL=debug

# Optional overrides from docs/SPEC.md §12.3:
# MAX_FILE_BYTES=524288000
# MAX_ENVELOPE_BYTES=65536
# RETENTION_DAYS=0
# WS_PING_SECONDS=60
# VAPID_SUBJECT=http://localhost:8080
# TRUST_PROXY=false
# WEB_DIST_DIR=../web/dist

# Isolated e2e storage (never reuse the persistent development bucket):
# mise exec -- pnpm tsx scripts/e2e/minio.ts start --env-out .env.e2e.local
# mise exec -- pnpm tsx scripts/e2e/minio.ts stop --name <PNEUMO_E2E_MINIO_NAME from that file>
# PNEUMO_E2E_MINIO=native uses minio and mc on PATH; automatic when docker is absent.
