{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "*.{json,jsonc,ts,yaml,yml,toml}",
      "packages/protocol/**",
      "packages/crypto/**",
      "apps/server/**",
      "apps/web/**",
      "scripts/**",
      "brand/**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!pnpm-lock.yaml",
      "!!**/generated",
      "!**/*.generated.*",
      "!**/*.gen.*",
      "!!apps/android",
      "!!brand/directions"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
