{
  "name": "@pneumo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "start": "node dist/index.js",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@hono/node-server": "2.1.5",
    "@pneumo/protocol": "workspace:*",
    "hono": "4.13.14",
    "pino": "10.4.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pneumo/crypto": "workspace:*",
    "@types/web-push": "3.6.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
